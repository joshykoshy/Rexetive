# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=openai
LLM_FAST_MODEL=gpt-4o-mini
LLM_SMART_MODEL=gpt-4o
ANTHROPIC_FAST_MODEL=claude-haiku-5-5
ANTHROPIC_SMART_MODEL=claude-opus-5-5
OFFLINE=0

# Auth
JWT_SECRET_KEY=change-me-to-a-long-random-string
# DEMO_MODE=true enables POST /auth/demo-login (no wallet). Clearly a demo bypass: never enable in production.
DEMO_MODE=true

# Chain: SUI_MOCK=1 (default) returns fake digests and logs "MOCK CHAIN". Set 0 + the values below for testnet.
SUI_MOCK=1
SUI_RPC_URL=https://fullnode.testnet.sui.io:443
SUI_PRIVATE_KEY=
SUI_ADDRESS=
PREDICTIONS_PACKAGE_ID=
PREDICTIONS_MODULE_NAME=rex
SUBMISSIONS_OBJECT_ID=
GAS_BUDGET=10000000
